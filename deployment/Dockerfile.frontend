# syntax=docker/dockerfile:1

# ----------------------------------------
# Build stage
# ----------------------------------------
FROM node:20-alpine AS build
WORKDIR /app

# Install dependencies (clean, reproducible installs)
COPY package.json ./
RUN npm install --no-audit --no-fund

# Build the production bundle
COPY . .
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

# ----------------------------------------
# Production stage
# ----------------------------------------
FROM nginx:alpine AS runtime

# Create non-root user for nginx
RUN addgroup -S app && adduser -S app -G app

# Copy built assets into nginx html root
COPY --from=build /app/dist /usr/share/nginx/html

# Replace default nginx config with SPA-friendly routing
RUN rm /etc/nginx/conf.d/default.conf
RUN printf 'server { listen 3000; server_name _; root /usr/share/nginx/html; index index.html; location / { try_files $uri $uri/ /index.html; } }\n' > /etc/nginx/conf.d/default.conf

# Adjust permissions for non-root nginx
RUN touch /var/run/nginx.pid \
    && chown -R app:app /var/run/nginx.pid /var/cache/nginx /usr/share/nginx/html /etc/nginx/conf.d \
    && sed -i 's/listen\s*80;/listen 3000;/g' /etc/nginx/conf.d/default.conf \
    && sed -i 's/user\s*nginx;/user app;/g' /etc/nginx/nginx.conf

USER app

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=30s \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
