# ==========================================================
# Environment configuration example for Enterprise Management System
# Copy this file to .env and fill in real values before deploying.
# ==========================================================

# ----- General -----
PROJECT_NAME=enterprise

# ----- Database (SQL Server) -----
SA_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_SQL_PASSWORD
DB_NAME=EnterpriseDb

# ----- Backend (.NET 9) -----
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=EnterpriseDb;User Id=sa;Password=REPLACE_WITH_UNIQUE_STRONG_SQL_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true
JWT__Secret=REPLACE_WITH_RANDOM_JWT_SECRET_AT_LEAST_32_BYTES
JWT__Issuer=https://enterprise.example.com
JWT__Audience=https://enterprise.example.com
JWT__AccessTokenExpiryMinutes=60
JWT__RefreshTokenExpiryDays=7
Serilog__WriteTo__0__Args__serverUrl=http://localhost:5341
BootstrapAdmin__Password=REPLACE_WITH_UNIQUE_STRONG_BOOTSTRAP_PASSWORD
CORS_ALLOWED_ORIGIN=https://enterprise.example.com

# ----- Frontend (Vite) -----
VITE_API_BASE_URL=/api
