DB_NAME=EnterpriseDb

# ----- Backend (.NET 9) -----
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=EnterpriseDb;User Id=sa;Password=Str0ng!P@ssw0rd#2024;TrustServerCertificate=True;MultipleActiveResultSets=true
JWT__Secret=ThisIsAVeryLongAndSecureJwtSigningSecretKeyThatMustBeAtLeast32CharactersLong!
