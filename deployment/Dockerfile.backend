# syntax=docker/dockerfile:1

# ----------------------------------------
# Build stage
# ----------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy project files and restore
COPY backend.csproj ./
RUN dotnet restore backend.csproj --disable-parallel

# Copy full source and build/publish
COPY . .
RUN dotnet publish backend.csproj -c Release -o /app/publish --no-restore \
    && chown -R app:app /app/publish

# ----------------------------------------
# Runtime stage
# ----------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app

# Create non-root user
RUN addgroup -S app && adduser -S app -G app

# Copy published output with correct ownership
COPY --from=build --chown=app:app /app/publish .

# Directories for logs and persistence
RUN mkdir -p /app/logs && chown -R app:app /app/logs

USER app

ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production
ENV HTTPS_PORT=443

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=40s \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["dotnet", "backend.dll"]
